# Copy to .env.local for development.
# In production (Vercel), set these as Environment Variables in the Vercel dashboard.

# Supabase (same project as the backend uses)
# Found in Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Backend API base URL (your Render service)
NEXT_PUBLIC_API_URL=https://ferrocrete-pay-app.onrender.com
