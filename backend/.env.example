# Copy this to .env and fill in values from your Supabase project dashboard.
# Never commit .env — it contains secrets.

APP_ENV=development
LOG_LEVEL=INFO

# Supabase — Project Settings > API in dashboard
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-jwt-secret-from-api-settings

# Storage buckets (create these in Supabase Storage; names must match)
BUCKET_PAY_APPS=pay-apps
BUCKET_RELEASE_TRACKERS=release-trackers
BUCKET_WAIVERS=waivers

# CORS — comma-separated origins. In dev: just the local Next.js port.
CORS_ORIGINS=http://localhost:3000

# Email
EMAIL_FROM=noreply@ferrocretebuilders.com
EMAIL_PROVIDER=outbox_only
# RESEND_API_KEY=re_xxx           # only if EMAIL_PROVIDER=resend

# Auth domain restriction
ALLOWED_EMAIL_DOMAIN=
# Set to e.g. "ferrocretebuilders.com" to restrict signups to that domain
